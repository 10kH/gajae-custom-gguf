# Example: a text-only reasoning model. Note MMPROJ_FILE is EMPTY -> no proxy,
# and GJC points straight at the llama-server port. Adjust REPO/MODEL_FILE to a
# real gguf (use `scripts/download.sh --list` to see a repo's quants).
REPO=Qwen/Qwen3-8B-GGUF
MODEL_FILE=Qwen3-8B-Q6_K.gguf
MMPROJ_FILE=
ALIAS=qwen3-8b
MODEL_DIR=$HOME/models/qwen3-8b

GPU=0
SPORT=8080
PPORT=8081
NGL=999

CTX_SIZE=40960
REASONING_BUDGET=-1
REASONING=true
MAXTOKENS=32768

# Qwen3 recommended sampling
TEMP=0.6
TOP_P=0.95
TOP_K=20

CUDA_HOME=/usr/local/cuda-12.6
CUDA_ARCHS="80;90"
CONDA_ENV=gguf
