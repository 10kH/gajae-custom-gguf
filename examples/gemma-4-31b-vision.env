# Example: Gemma-4-31B (heretic, uncensored) — multimodal (text + vision).
# Verified working. Q8_0 ~31GB + mmproj ~1.2GB -> ~38GB VRAM.
REPO=llmfan46/gemma-4-31B-it-uncensored-heretic-GGUF
MODEL_FILE=gemma-4-31B-it-uncensored-heretic-Q8_0.gguf
MMPROJ_FILE=gemma-4-31B-it-mmproj-BF16.gguf
ALIAS=gemma-4-31b
MODEL_DIR=$HOME/models/gemma-4-31B-heretic

GPU=0
SPORT=8080
PPORT=8081
NGL=999

CTX_SIZE=65536
REASONING_BUDGET=-1
REASONING=true
MAXTOKENS=32768

TEMP=1.0
TOP_P=0.95
TOP_K=64

CUDA_HOME=/usr/local/cuda-12.6
CUDA_ARCHS="80;90"
CONDA_ENV=gguf
