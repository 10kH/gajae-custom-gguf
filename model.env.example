# ── gajae-custom-gguf: per-model config ───────────────────────────────────────
# Copy this file to `model.env` (git-ignored) and fill it in ONCE per model.
# Every script in scripts/ sources it, so nothing is hardcoded to one model.
#   cp model.env.example model.env  &&  $EDITOR model.env
# Override the location for a second model with:  MODEL_ENV=/path/to/other.env ./scripts/start.sh
# See examples/ for ready-made vision + text-only configs.

# ── What to download ──────────────────────────────────────────────────────────
REPO=llmfan46/gemma-4-31B-it-uncensored-heretic-GGUF   # Hugging Face repo id
MODEL_FILE=gemma-4-31B-it-uncensored-heretic-Q8_0.gguf # main weights quant
MMPROJ_FILE=gemma-4-31B-it-mmproj-BF16.gguf            # vision projector; LEAVE EMPTY for text-only
ALIAS=gemma-4-31b                                       # short id used everywhere (server --alias + GJC)
MODEL_DIR=$HOME/models/gemma-4-31B-heretic             # where the .gguf files live

# Pick a quant by VRAM: Q8_0 (~lossless, big) | Q6_K (excellent) | Q4_K_M (small GPUs).
# List a repo's ggufs:  scripts/download.sh --list   (or see README §3)

# ── Where / how to serve ──────────────────────────────────────────────────────
GPU=0            # CUDA device index (see README §8 — ordering may != nvidia-smi)
SPORT=8080       # llama-server port
PPORT=8081       # webp proxy port (vision only)
NGL=999          # --n-gpu-layers (all on GPU); lower if VRAM is tight

# ── Context + reasoning ───────────────────────────────────────────────────────
CTX_SIZE=65536         # one big --parallel 1 slot so long "thinking" is never truncated
REASONING_BUDGET=-1    # -1 = unrestricted thinking (reasoning models); harmless otherwise
REASONING=true         # register the model in GJC with a thinking trace (false = plain model)
MAXTOKENS=32768        # GJC per-response cap

# ── Sampling (use the model card's recommended values) ────────────────────────
TEMP=1.0
TOP_P=0.95
TOP_K=64

# ── Toolchain ─────────────────────────────────────────────────────────────────
# All of these are AUTO-DETECTED. Set one only when detection picks wrong.
CONDA_ENV=gguf                   # conda env holding aiohttp+Pillow+huggingface_hub
                                 # (leave empty to just use whatever python is on PATH)

# CUDA_HOME=/usr/local/cuda-12.6  # auto: $CUDA_HOME -> nvcc on PATH -> newest /usr/local/cuda* -> $CONDA_PREFIX
# CUDA_ARCHS="80;90"              # auto: read from nvidia-smi compute_cap; else "native"
#                                 # 80=A100 86=RTX30xx 89=RTX40xx 90=H100 (quote it — ; splits commands)
# CONDA_SH=/opt/conda/etc/profile.d/conda.sh   # auto: miniforge3/mambaforge/miniconda3/anaconda3/opt/conda/$CONDA_EXE
# PYTHON=/usr/bin/python3         # auto: $PYTHON -> python3 -> python
# LLAMA_SRC=$HOME/llama.cpp       # llama.cpp checkout (default $HOME/llama.cpp)
# LLAMA_BIN=$HOME/llama.cpp/build/bin/llama-server   # override the server binary path
